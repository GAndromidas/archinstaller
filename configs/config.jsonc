{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "auto",
    "padding": {
      "top": 5,
      "left": 3,
      "right": 5
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 20
    },
    "percent": {
      "type": 9
    },
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;59;130;246m┌───────────────────────────  System  ───────────────────────────┐\u001b[0m"
    },
    {
      "type": "os",
      "key": "  \u001b[38;2;59;130;246m{icon}  OS\u001b[0m",
      "keyColor": "38;2;59;130;246",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "  \u001b[38;2;59;130;246m󰌽  Kernel\u001b[0m",
      "keyColor": "38;2;59;130;246",
      "format": "{sysname} {release}"
    },
    {
      "type": "de",
      "key": "  \u001b[38;2;59;130;246m󰍹  Desktop\u001b[0m",
      "keyColor": "38;2;59;130;246",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "wm",
      "key": "  \u001b[38;2;59;130;246m󰨡  WM\u001b[0m",
      "keyColor": "38;2;59;130;246",
      "format": "{pretty-name} ({protocol-name})"
    },
    {
      "type": "terminal",
      "key": "  \u001b[38;2;59;130;246m󰆍  Terminal\u001b[0m",
      "keyColor": "38;2;59;130;246",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminalfont",
      "key": "  \u001b[38;2;59;130;246m󰛖  Font\u001b[0m",
      "keyColor": "38;2;59;130;246",
      "format": "{name}"
    },
    {
      "type": "shell",
      "key": "  \u001b[38;2;59;130;246m󰞷  Shell\u001b[0m",
      "keyColor": "38;2;59;130;246",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "packages",
      "key": "  \u001b[38;2;59;130;246m  Packages\u001b[0m",
      "keyColor": "38;2;59;130;246",
      "format": "{all}"
    },
    {
      "type": "locale",
      "key": "  \u001b[38;2;59;130;246m󰗊  Locale\u001b[0m",
      "keyColor": "38;2;59;130;246",
      "format": "{result}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;59;130;246m└────────────────────────────────────────────────────────────────┘\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;96;165;250m┌──────────────────────────  Hardware  ──────────────────────────┐\u001b[0m"
    },
    {
      "type": "board",
      "key": "  \u001b[38;2;96;165;250m󰍛  Motherboard\u001b[0m",
      "keyColor": "38;2;96;165;250"
    },
    {
      "type": "bios",
      "key": "  \u001b[38;2;96;165;250m  BIOS\u001b[0m",
      "keyColor": "38;2;96;165;250"
    },
    {
      "type": "cpu",
      "key": "  \u001b[38;2;96;165;250m  CPU\u001b[0m",
      "keyColor": "38;2;96;165;250",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "  \u001b[38;2;96;165;250m󰢮  GPU\u001b[0m",
      "keyColor": "38;2;96;165;250",
      "temp": true
    },
    {
      "type": "display",
      "key": "  \u001b[38;2;96;165;250m  Resolution\u001b[0m",
      "keyColor": "38;2;96;165;250"
    },
    {
      "type": "memory",
      "key": "  \u001b[38;2;96;165;250m  Memory\u001b[0m",
      "keyColor": "38;2;96;165;250"
    },
    {
      "type": "swap",
      "key": "  \u001b[38;2;96;165;250m󰍛  Swap\u001b[0m",
      "keyColor": "38;2;96;165;250"
    },
    {
      "type": "disk",
      "key": "  \u001b[38;2;96;165;250m  Disk\u001b[0m",
      "keyColor": "38;2;96;165;250"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;96;165;250m└────────────────────────────────────────────────────────────────┘\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;147;197;253m┌───────────────────────────  Status  ───────────────────────────┐\u001b[0m"
    },
    {
      "type": "localip",
      "key": "  \u001b[38;2;147;197;253m󰩟  Local IP\u001b[0m",
      "keyColor": "38;2;147;197;253",
      "format": "{ipv4} ({ifname})",
      "showIpv6": false,
      "showPrefixLen": false
    },
    {
      "type": "datetime",
      "key": "  \u001b[38;2;147;197;253m󰸗  Date\u001b[0m",
      "keyColor": "38;2;147;197;253",
      "format": "{day-in-month}.{month-pretty}.{year}  {hour-pretty}:{minute-pretty}:{second-pretty}"
    },
    {
      "type": "command",
      "key": "  \u001b[38;2;147;197;253m  OS Age\u001b[0m",
      "keyColor": "38;2;147;197;253",
      "text": "birth_install=$(stat -c %W / 2>/dev/null || stat -c %Y /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "  \u001b[38;2;147;197;253m  Uptime\u001b[0m",
      "keyColor": "38;2;147;197;253"
    },
    {
      "type": "battery",
      "key": "  \u001b[38;2;147;197;253m  Battery\u001b[0m",
      "keyColor": "38;2;147;197;253"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;147;197;253m└────────────────────────────────────────────────────────────────┘\u001b[0m"
    }
  ]
}
