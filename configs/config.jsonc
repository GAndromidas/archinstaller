{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "height": 8,
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " •  ",
    "color": {
      "keys": "cyan",
      "title": "blue"
    },
    "key": {
      "width": 18
    },
    "percent": {
      "type": 1
    }
  },
  "modules": [
    // --- USER & HOST ---
    {
      "type": "title",
      "format": "  {user-name-colored}@{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "  ───────────────────────────────────"
    },

    // --- SYSTEM INFO ---
    {
      "type": "os",
      "key": "  {icon} OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "  󰌽 Kernel",
      "keyColor": "cyan",
      "format": "{1} {2}"
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages",
      "keyColor": "cyan",
      "format": "{all}"
    },

    "break",

    // --- DESKTOP ENVIRONMENT ---
    {
      "type": "de",
      "key": "  󰧨 DE",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "  󱂬 WM",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "  󰆍 Terminal",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "  󰞷 Shell",
      "keyColor": "magenta"
    },

    "break",

    // --- HARDWARE SPECS ---
    {
      "type": "cpu",
      "key": "  󰍛 CPU",
      "keyColor": "green",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "  󰢮 GPU",
      "keyColor": "green",
      "temp": true
    },
    {
      "type": "memory",
      "key": "  󰘚 Memory",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "  󰓡 Swap",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "  󰋊 Disk",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "keyColor": "green",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "battery",
      "key": "  󰁹 Battery",
      "keyColor": "green"
    },

    "break",

    // --- TIME & OS AGE ---
    {
      "type": "uptime",
      "key": "  󱎫 Uptime",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": "  󰃭 OS Age",
      "keyColor": "yellow",
      "text": "birth_install=$(stat -c %W / 2>/dev/null || stat -c %Y /); current=$(date +%s); echo $(( (current - birth_install) / 86400 )) days"
    },

    "break",

    // --- COLOR PALETTE ---
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
